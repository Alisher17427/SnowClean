shader_type canvas_item;

// лёгкая виньетка по краям экрана - чисто оформление (пост-процессинг), без игровой
// логики и настроек; интенсивность зашита прямо тут, поэтому отдельного uniform,
// который выставлял бы скрипт каждый кадр (как у инея), не нужно

void fragment() {
	vec2 uv = UV - 0.5;
	// компенсируем соотношение сторон, чтобы затемнение было одинаковым по кругу,
	// а не сильнее по бокам, как было бы для голого расстояния в UV-координатах
	float dist = length(uv * vec2(1.0, 0.8));
	float vignette = smoothstep(0.35, 0.92, dist);
	COLOR = vec4(0.0, 0.0, 0.0, vignette * 0.4);
}
