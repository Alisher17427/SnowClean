extends RefCounted

# Записи шагов по снегу (нарезаны из dragon-studio-footsteps-in-snow.mp3),
# моно 16 бит 22050 Гц, в base64 - чтобы не требовался импорт файлов.

const RATE = 22050
const CLIPS = [
	"",
	"",
	"",
	"",
	"",
	"",
]

static func make_streams() -> Array:
	var result = []
	for b64 in CLIPS:
		var s = AudioStreamWAV.new()
		s.format = AudioStreamWAV.FORMAT_16_BITS
		s.mix_rate = RATE
		s.stereo = false
		s.data = Marshalls.base64_to_raw(b64)
		result.append(s)
	return result
